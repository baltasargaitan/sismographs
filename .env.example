# Database Connection
# For local development with SQL Server Express
# Replace with your SQL Server instance if different
ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS;Database=SistemaSismografosDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;

# SMTP Configuration (Email Notifications via Mailjet)
# Obtain credentials from your Mailjet account: https://app.mailjet.com/settings/account
MAIL_USER=replace-with-mailjet-api-key
MAIL_KEY=replace-with-mailjet-secret-key
SMTP_FROM=noreply@yourdomain.com
SMTP_NAME=Sistema Sismografos

# Frontend Origin (CORS)
# URL where the React frontend is served
FRONTEND_ORIGIN=http://localhost:5173

# Logging Configuration (Optional)
# Valid levels: Trace, Debug, Information, Warning, Error, Critical
# LOG_LEVEL=Information
